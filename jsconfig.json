{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "paths": {
      "components/*": ["./src/components/*"],
      "composition/*": ["./src/composition/*"],
      "containers/*": ["./src/containers/*"],
      "constants": ["./src/constants"],
      "constants/*": ["./src/constants/*"],
      "helpers": ["./src/helpers"],
      "helpers/*": ["./src/helpers/*"],
      "hooks/*": ["./src/hooks/*"],
      "context": ["./src/context"],
      "context/*": ["./src/context/*"],
      "layout/*": ["./src/layout/*"]
    }
  },
  "include": ["src"]
}
